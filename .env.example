# ── Βάση της μηχανής (χωριστή από τη βάση του eshop) ──────────────────────────
# Η εφαρμογή μέσω PgBouncer (6432). ΟΧΙ ?pgbouncer=true (κλείνει τα prepared statements, ~5× πιο αργό).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6432/euronics_stock?schema=public"
# Migrations απευθείας στον Postgres (5432) — ο PgBouncer δεν τις σηκώνει
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/euronics_stock?schema=public"
# Συνδέσεις ανά διεργασία (προεπιλογή: 10 μέσω PgBouncer, 4 απευθείας)
# DB_POOL=10

# ── Κλειδιά (δημιουργία: npm run keys:gen) ────────────────────────────────────
# Κρυπτογράφηση των διαπιστευτηρίων των μελών. id:base64(32 bytes)· το πρώτο κρυπτογραφεί, όλα αποκρυπτογραφούν.
SECRETS_KEYS=
# Υπογραφή των κλήσεων eshop → μηχανή. ΙΔΙΑ τιμή στο eshop (B2B_ENGINE_SECRET).
INTERNAL_HMAC_SECRET=
# Προαιρετικά: μόνο από αυτές τις IP δέχεται εσωτερικές κλήσεις (η IP του server του eshop), χωρισμένες με κόμμα
# INTERNAL_ALLOWED_IPS=

# ── Μόνο για τοπικές δοκιμές ─────────────────────────────────────────────────
# Επιτρέπει feeds/servers σε εσωτερικό δίκτυο (localhost κ.λπ.). ΠΟΤΕ στην παραγωγή.
# ALLOW_PRIVATE_NETWORK=1
